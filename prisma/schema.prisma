generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model student {
  Id     Int    @id @unique(map: "Id_UNIQUE")
  Name   String @db.VarChar(45)
  Age    String @db.VarChar(45)
  Sem    String @db.VarChar(45)
  Course String @db.VarChar(45)
}
